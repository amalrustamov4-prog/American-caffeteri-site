{
  "name": "american-caffetteria-app",
  "version": "1.0.0",
  "description": "American Caffetteria Mobile App (Termez, Uzbekistan)",
  "main": "index.html",
  "scripts": {
    "start": "python -m http.server 3000",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "sync": "python sync_web.py",
